# Live-model acceptance — model selection
#
# The ticket suite (tests/tickets/) proves the loop is wired correctly using a
# deterministic tool-call seam. That is necessary but not sufficient: it never
# proves a MODEL chooses read → edit → test on its own.
#
# This file records which model the live run uses, so a screenshot of the
# result and the config that produced it can never disagree.

provider:        nvidia            # NVIDIA NIM (build.nvidia.com)
model:           deepseek-ai/DeepSeek-V4-Flash-0731
catalog_id:      deepseek-ai/deepseek-v4-flash-0731
coworker:        Wei
key_env_var:     NVIDIA_API_KEY
base_url:        https://integrate.api.nvidia.com/v1

# Repo reference (src/providers/catalog/WorkerRouter.js)
#   coder.providers[0] = { key: 'nvidia', model: 'deepseek-ai/deepseek-v4-flash-0731' }
# Capabilities (src/providers/adapters/deepseek.js): toolCalling true,
#   codeReasoning strong, structuredOutput true, streaming true.

# What the live run must show, per the target path:
#   fix failing pytest -> classify CODE -> plan -> read failing test + module
#   -> fs_edit -> sandboxed pytest_run -> independent TestVerifier on the
#   materialized snapshot -> answer carrying a REAL exit code
#
# A pass REQUIRES: model-emitted tool calls (not the scripted seam), a real
# pytest exit code, and independent verifier evidence. Model prose is not
# evidence.
