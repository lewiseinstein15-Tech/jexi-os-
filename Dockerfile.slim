# JEXI OS — SLIM image (no Chromium) for image-based deploys.
# Built by GitHub Actions → ghcr.io — Render pulls the ready image, so the
# free plan's BUILD minutes are never touched (that was the Render limit).
# RAM-friendly for 512MB instances: ~600MB image, no browser in memory.
# Browser-control is off (JEXI_NO_BROWSER=1 default) — search, research,
# math, coding, /watch (ffmpeg+yt-dlp included) and vision all work.

FROM node:22-slim

# ffmpeg (video frames/audio) + python3/pip (yt-dlp) for /watch
# qrencode + pandoc: binaries the qrcode/pandoc MCP servers shell out to.
# uv: fast Python runner for the uvx-based MCP servers (sqlite, osm, rss,
# chroma, mermaid, pandoc, ...) — no pip venv juggling, cached wheels.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg python3 python3-pip ca-certificates fonts-liberation qrencode pandoc curl \
    && rm -rf /var/lib/apt/lists/* \
    && (pip3 install --no-cache-dir --break-system-packages yt-dlp \
        || pip3 install --no-cache-dir yt-dlp \
        || echo 'WARN: yt-dlp install failed — /watch URL mode degrades') \
    && (curl -LsSf https://astral.sh/uv/install.sh | sh \
        && cp /root/.local/bin/uv /usr/local/bin/uv && cp /root/.local/bin/uvx /usr/local/bin/uvx \
        || echo 'WARN: uv install failed — python uvx MCP servers degrade')

WORKDIR /app

# Pre-warm the npx/uvx MCP package caches: the first connect on Render must
# never pay the cold PyPI/npm download (it can exceed the 60s connect window).
# mcp/ lives INSIDE server/ since the f5659d0 layout move — copy it there.
COPY server/mcp/registry.json ./server/mcp/registry.json
COPY server/scripts/mcp-prewarm.mjs ./server/scripts/mcp-prewarm.mjs
RUN cd server && node scripts/mcp-prewarm.mjs 300

# Backend dependencies (NO playwright browser download in the slim image)
COPY server/package*.json ./server/
RUN cd server && npm ci --no-audit --no-fund

COPY server ./server

# AGI Phase 2 — the MCP server registry ships with the brain (server/mcp/,
# where MCPGateway resolves ../../mcp/registry.json from src/services).
COPY server/mcp ./server/mcp

# Frontend build → served by Express from server/public
COPY package*.json index.html vite.config.js tailwind.config.js postcss.config.js ./
# ── Boot-chain trees ───────────────────────────────────────────────────────
# server/index.js imports src/wiring/phase31-bootstrap.js, whose static ESM
# closure reaches ../{mind,runtime,harness,services,capabilities,agents,
# integrations,skills,security,tests,interfaces}. ESM link resolution runs
# BEFORE app.listen(): a missing tree crashes the container with
# ERR_MODULE_NOT_FOUND (observed: /app/mind/brain/repo/index.js).
# Phase 7(G)/24 shipped only narrow subtrees (commands, events, workforce,
# providers) — superseded by the whole-tree copies below.
COPY interfaces ./interfaces
COPY capabilities ./capabilities
COPY runtime ./runtime
COPY integrations ./integrations
COPY agents ./agents
COPY mind ./mind
COPY harness ./harness
COPY services ./services
COPY skills ./skills
COPY security ./security
COPY tests ./tests
RUN npm ci --no-audit --no-fund && npm run build
# server/public is a git symlink to ../dist — vite writes the bundle
# straight through it, so the old `cp -r dist/* server/public/` copied
# dist onto ITSELF and failed with "are the same file".

ENV NODE_ENV=production
# PERMANENT drop fix #1: Node's default heap (~2GB+) lets the brain grow past
# Render free's 512MB container → cgroup OOM-kill mid-task → dropped stream.
# Cap V8 at 384MB so GC runs early; the process stays alive instead.
ENV NODE_OPTIONS=--max-old-space-size=384
ENV PORT=7860
# Ephemeral scratch storage (memory/history ride the external store instead)
ENV DATA_DIR=/data
ENV WORKSPACE_DIR=/data/workspace
# Slim image ships no Chromium: disable browser-control by default (override
# with a full image if ever needed)
ENV JEXI_NO_BROWSER=1

EXPOSE 7860
WORKDIR /app/server
CMD ["node", "index.js"]
