# JEXI OS Environment Variables
# Get your free Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# REQUIRED for any non-local deployment — locks every /api endpoint behind the
# x-jexi-key header (paste the same key in Settings → System on the app).
# Without it the server REFUSES to start in production, and in dev it binds to
# 127.0.0.1 only (fail-closed).
# JEXI_API_KEY=your_secret_passphrase

# ONLY for local testing: allows running without a key on the network.
# JEXI_ALLOW_UNLOCKED=1

# Optional: For persistent memory across serverless restarts
# Use Upstash Redis (free tier) or Supabase (free tier)
# REDIS_URL=rediss://default:...@...upstash.io:6379
# SUPABASE_URL=https://...supabase.co
# SUPABASE_KEY=eyJ...