# Dependencies
node_modules/
server/node_modules/
frontend/node_modules/

# Build outputs
.next/
dist/
server/public/
frontend/dist/

# Environment & Secrets
.env
settings.json
task_state.json

# Runtime data (memory core, knowledge library, generated files)
server/data/
# Root runtime data dir (ProviderHealth ledger etc. — written relative to
# CWD as ./data; ZONE-OWNER item 39). Root-anchored on purpose: agents/data/
# and skills/**/data/ hold TRACKED content and must not be ignored.
/data/
# Evaluation run log — every `node evaluation/run.js` (and thus every full
# suite run) rewrites its dated row; run.js recreates the file from scratch
# when absent (ZONE-OWNER item 40). run.js/tasks.js stay tracked.
server/evaluation/RESULTS.md
server/jexi-workspace/
.jexi/

# System files
.DS_Store
*.log

# Firebase service account (private key — NEVER commit)
server/firebase-service-account.json
.aider*

__pycache__/
*.pyc
.jexi-secrets/
scripts/apkinspect/
infra/hooks/state/

# Suite-runner scratch state (chunked test runner) — untracked by design;
# listed here so probe zone checks (git status --porcelain) never see it.
scripts/.chunked-state.json
