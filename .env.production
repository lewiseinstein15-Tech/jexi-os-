# JEXI OS — baked brain address for production builds (APK + static web).
# This is the Render web service defined in render.yaml (jexi-os-brain).
# The classic shell (utils/helpers.js getBackendUrl) and the console
# ServerRow both fall back to this when localStorage has no override.
VITE_JEXI_BACKEND_URL=https://jexi-os-brain.onrender.com
