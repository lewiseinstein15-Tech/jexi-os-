# JEXI OS Environment Variables
# Get your free Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# REQUIRED for any non-local deployment — locks every /api endpoint behind the
# x-jexi-key header (paste the same key in Settings → System on the app).
# Without it the server REFUSES to start in production, and in dev it binds to
# 127.0.0.1 only (fail-closed).
# JEXI_API_KEY=your_secret_passphrase

# ONLY for local testing: allows running without a key on the network.
# JEXI_ALLOW_UNLOCKED=1

# Optional: For persistent memory across serverless restarts
# Use Upstash Redis (free tier) or Supabase (free tier)
# REDIS_URL=rediss://default:...@...upstash.io:6379
# SUPABASE_URL=https://...supabase.co
# SUPABASE_KEY=eyJ...

# Optional: email goal completion reports to this address (requires the Email
# connector / RESEND_API_KEY). Defaults in code to lewiseinstein15@gmail.com —
# set this to override, or leave unset to always report to the creator.
# GOAL_REPORT_EMAIL=you@example.com
# ── FREE search upgrades (email signup only, NO credit card) ─────────────
# Tavily  — 1,000 searches/month free  → https://app.tavily.com
# Brave   — 2,000 searches/month free  → https://brave.com/search/api
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── FREE DeepSeek brain (no card) ────────────────────────────────────────
# NVIDIA NIM  — free credits, DeepSeek V4 Flash → https://build.nvidia.com
# SambaNova   — free tier, DeepSeek V3.1/3.2    → https://cloud.sambanova.ai
# NVIDIA_API_KEY=
# SAMBANOVA_API_KEY=
