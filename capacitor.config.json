{
  "appId": "com.jexi.os",
  "appName": "JEXI OS",
  "webDir": "dist",
  "backgroundColor": "#0c0b09",
  "android": {
    "path": "interfaces/android",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0c0b09",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0c0b09",
      "overlaysWebView": false
    }
  }
}