# JEXI OS Environment Variables
#
# ── THE ONE-SECRET MODEL (recommended) ─────────────────────────────────
# JEXI needs exactly ONE model credential. Pick a provider, paste one key,
# name one model — everything else (agents, tools, memory, search, MCP)
# works without additional keys.
#   Provider IDs: openai anthropic gemini groq deepseek openrouter mistral
#     xai nvidia sambanova cerebras deepinfra huggingface ollama lmstudio
#     vllm custom
JEXI_MODEL_PROVIDER=groq
JEXI_MODEL_API_KEY=gsk_your_groq_api_key_here
JEXI_MODEL_NAME=openai/gpt-oss-120b
# Only for provider=custom (or to override a default endpoint):
# JEXI_MODEL_BASE_URL=https://your-openai-compatible-host/v1
#
# Legacy per-provider keys still work as automatic fallback legs:
# Get your free Groq API key from: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_api_key_here

# REQUIRED for any non-local deployment — locks every /api endpoint behind the
# x-jexi-key header (paste the same key in Settings → System on the app).
# Without it the server REFUSES to start in production, and in dev it binds to
# 127.0.0.1 only (fail-closed).
# JEXI_API_KEY=your_secret_passphrase

# ONLY for local testing: allows running without a key on the network.
# JEXI_ALLOW_UNLOCKED=1

# Optional: For persistent memory across serverless restarts
# Use Upstash Redis (free tier) or Supabase (free tier)
# REDIS_URL=rediss://default:...@...upstash.io:6379
# SUPABASE_URL=https://...supabase.co
# SUPABASE_KEY=eyJ...

# Optional: email goal completion reports to this address (requires the Email
# connector / RESEND_API_KEY). Defaults in code to lewiseinstein15@gmail.com —
# set this to override, or leave unset to always report to the creator.
# GOAL_REPORT_EMAIL=you@example.com
# ── FREE search upgrades (email signup only, NO credit card) ─────────────
# Tavily  — 1,000 searches/month free  → https://app.tavily.com
# Brave   — 2,000 searches/month free  → https://brave.com/search/api
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── FREE DeepSeek brain (no card) ────────────────────────────────────────
# NVIDIA NIM  — free credits, DeepSeek V4 Flash → https://build.nvidia.com
# SambaNova   — free tier, DeepSeek V3.1/3.2    → https://cloud.sambanova.ai
# NVIDIA_API_KEY=
# SAMBANOVA_API_KEY=

# ── Durable memory layer (pick one — Turso preferred) ─────────────────────
# Turso (free, no card, never sleeps): create a DB at https://turso.tech,
# then paste its libsql:// URL + an API token. Preferred over REDIS_URL
# when both are set.
# TURSO_URL=libsql://your-db-....turso.io
# TURSO_TOKEN=
# Legacy Redis fallback (Upstash REST or TCP). Only used when TURSO_URL
# is unset.
# REDIS_URL=https://your-db.upstash.io
# REDIS_TOKEN=your_rest_token

# ── One-key free AI routers (no card) ─────────────────────────────────────
# Pollinations (REQUIRED from server networks — anonymous is browser-only):
# free key at https://enter.pollinations.ai/keys
# POLLINATIONS_API_KEY=
# Cloudflare Workers AI (one token → 50+ open models, 10k neurons/day):
# dash.cloudflare.com → Workers & Pages → AI → API token (+ account ID)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── Search mesh upgrades (all free, no card — mesh works keyless too) ─────
# FIRECRAWL_API_KEY=   # 1,000 credits/month → https://firecrawl.dev
# EXA_API_KEY=         # $20 signup + $10/month → https://exa.ai
# PARALLEL_API_KEY=    # raises anonymous MCP quota → https://parallel.ai
# ANYSEARCH_API_KEY=   # raises anonymous quota → https://www.anysearch.com
